#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Create the system user only if it does not exist; never modify an existing one.
    if ! getent passwd feed-index >/dev/null; then
        if getent group feed-index >/dev/null; then
            adduser --system --ingroup feed-index --no-create-home \
                --home /nonexistent --quiet feed-index
        else
            adduser --system --group --no-create-home \
                --home /nonexistent --quiet feed-index
        fi
    fi
fi

# Register the units. Nothing is enabled here. prerm stops the timer, also on upgrade, so if
# the admin has enabled it, start it again.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
    if [ "$1" = "configure" ] && systemctl is-enabled --quiet feed-index-fetch.timer 2>/dev/null; then
        systemctl start feed-index-fetch.timer >/dev/null || true
    fi
fi

exit 0
